# Cloudflare Static Assets redirects
# Format: <from> <to> <status>
# See apps/website/AGENTS.md "URL changes require a redirect" - every move/rename
# of a content file MUST add an entry here so we don't lose Google index signal.

# API reference moved out of /docs/ and remains on the main site at /api/.
/docs/api/                              /api/                 301
/docs/api/*                             /api/:splat           301

# Removed docs pages (redirect to the closest still-existing parent on the new
# docs subdomain; the /docs/* catch-all below finishes the hop).
/docs/guides/control-from-browser/      /docs/guides/         301
/docs/errors/account_suspended/         /docs/errors/         301
/docs/errors/account_deletion_pending/  /docs/errors/         301

# Docs moved to https://docs.devicesdk.com. The wildcard preserves the path
# after /docs/ (e.g. /docs/quickstart/ -> https://docs.devicesdk.com/quickstart/).
/docs                                   https://docs.devicesdk.com/ 301
/docs/*                                 https://docs.devicesdk.com/:splat 301

# Self-host pivot: pages removed when DeviceSDK became free, open-source, and
# self-hosted (no managed cloud, no pricing, no private beta).
/pricing/                               /                     301
/early-access/                          https://docs.devicesdk.com/quickstart/ 301
